{
  "name": "@safefypay/safefy-mcp",
  "version": "1.1.0",
  "description": "MCP server oficial Safefy Payment — integração com a API de pagamentos via Model Context Protocol",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Safefy-Pay/safefy-mcp.git"
  },
  "homepage": "https://github.com/Safefy-Pay/safefy-mcp#readme",
  "bugs": {
    "url": "https://github.com/Safefy-Pay/safefy-mcp/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "safefy-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build",
    "verify": "npm run check && npm run build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "publish:npm": "npm publish --access public",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "safefy",
    "payments",
    "pix",
    "api",
    "typescript",
    "node"
  ],
  "author": "Matheus Louly",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
